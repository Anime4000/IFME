[Languages]
Name: "english";  MessagesFile: "compiler:Default.isl"
;Name: "chinese";  MessagesFile: "compiler:Languages\ChineseSimpolified.isl"
Name: "italian";  MessagesFile: "compiler:Languages\Italian.isl"
Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl"


[Messages]

SetupWindowTitle=Installation of {#MyAppName} {#MyAppVersion}
italian.SetupWindowTitle=Installazione di {#MyAppName} {#MyAppVersion}

[CustomMessages]

; enhlisg strings valid for all language when no defined
CreateShortcutQt=Create a desktop shortcut for {#QtAppName}

; italian strings
italian.CreateShortcutQt=Crea collegamento sul desktop per {#QtAppName}
; additional italian strings to fix italian isl issues
italian.NameAndVersion=%1 %2
italian.LaunchProgram=Esegui %1
italian.AdditionalIcons=Attività aggiuntive:
italian.CreateDesktopIcon=Crea collegamento programma sul &desktop
italian.CreateQuickLaunchIcon=Crea collegamento programma nella &barra 'Avvio veloce'
italian.AssocFileExtension=&Associa i file con estensione '%2' a '%1'
italian.AssocingFileExtension=Associazione file con estensione '%2' a '%1'...

