// Generated by CMake from ifme-app.rc.in for @IFME_EXE_NAME@: the manifest, the
// IFME icon and the file details Windows shows in Properties > Details (the
// same fields as IFME 8's AssemblyInfo).
#pragma code_page(65001)
#include <winver.h>

1 24 "@IFME_MANIFEST@"
IDI_ICON1 ICON "@IFME_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       VS_FF_PRERELEASE
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"   // language neutral, Unicode (as IFME 8)
        BEGIN
            VALUE "Comments",         "Allow user to compress raw media"
            VALUE "CompanyName",      "Anime4000"
            VALUE "FileDescription",  "@IFME_EXE_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@IFME_EXE_NAME@"
            VALUE "LegalCopyright",   "© @IFME_COPYRIGHT_YEAR@ Anime4000"
            VALUE "LegalTrademarks",  "@IFME_TRADEMARKS@"
            VALUE "OriginalFilename", "@IFME_EXE_NAME@"
            VALUE "ProductName",      "@IFME_CODENAME@"
            VALUE "ProductVersion",   "@IFME_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 1200
    END
END
