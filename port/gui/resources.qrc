<!DOCTYPE RCC>
<!-- Only what resources.wad / jason.wad do not provide: the icon, and a copy of
     Language.json for when jason.wad is missing. The artwork comes from
     resources.wad at run time (wad.cpp), as IFME 8 does. -->
<RCC version="1.0">
	<qresource prefix="/ifme">
		<file alias="icon.ico">../../IFME/Resources/ifme-zenui.ico</file>
		<file alias="Language.json">../../IFME/Language.json</file>
	</qresource>
</RCC>
